# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mundo_exotico"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# API URLs
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Image Storage (Cloudinary or similar)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email Service (Resend or SendGrid)
RESEND_API_KEY="your-resend-api-key"

# Payment Providers (Not implemented yet, prepare structure)
STRIPE_SECRET_KEY="your-stripe-secret"
STRIPE_PUBLIC_KEY="your-stripe-public"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

MERCADO_PAGO_ACCESS_TOKEN="your-mercado-pago-token"
MERCADO_PAGO_PUBLIC_KEY="your-mercado-pago-public-key"

# Admin Settings
ADMIN_EMAIL="admin@mundoexotico.com"

# Development
NODE_ENV="development"
